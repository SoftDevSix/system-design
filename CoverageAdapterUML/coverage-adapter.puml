@startuml CoverageAdapter
package "Coverage Adapter"{

    class Injecter {
        - String methodName
        - String methodDesc
        - String className
        + void visitLineNumber(int line, Label start)
    }

    class CoverageAdapter {
        - String className
        + Override visitMethod(int access, String name, String desc, String signature, String[] exceptions) 
    }

    CoverageAdapter ..> Injecter : Uses
}
@enduml